# Supabase client authentication
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# Server-side direct database connection (for dashboard metrics, public share links, and exports)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Backend worker base URL (delegates Q&A and wakes sleeping worker hosts)
WORKER_HEALTH_URL=http://localhost:3001

# (Optional: Only needed if running without the background worker)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
