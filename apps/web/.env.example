# Web app environment — copy to `.env.local`. Never commit real values.
# Supabase dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# NOTE: the web app deliberately does NOT get the service-role key. Job rows are
# created as the authenticated user and RLS enforces ownership. Only the worker
# holds elevated DB credentials. See docs/decision-log.md D6.
