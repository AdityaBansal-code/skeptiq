# Worker environment — copy to `.env` and fill in. Never commit `.env`.

# Postgres connection string for the Supabase project.
#
# ⚠ Use the CONNECTION POOLER string, not the "Direct connection" one.
# The direct host (db.<ref>.supabase.co) is IPv6-only and fails with ENOTFOUND
# on IPv4-only networks. The pooler is IPv4-compatible.
#
# Supabase dashboard → Project Settings → Database → "Connection string" →
# choose "Session pooler" (port 5432 — the worker holds a long-lived pool, so
# NOT "Transaction pooler" on 6543). It looks like:
#
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
DATABASE_URL=

# How often (ms) the worker polls simulation_jobs for queued work.
WORKER_POLL_INTERVAL_MS=2000

# debug | info | warn | error
LOG_LEVEL=info

# Groq API key for multi-agent LLM inference (console.groq.com)
GROQ_API_KEY=gsk_...

