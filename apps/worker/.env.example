# Worker environment — copy to `.env` and fill in. Never commit `.env`.

# Postgres connection string for the Supabase project.
# Supabase dashboard → Project Settings → Database → Connection string → "URI".
# Use the direct connection or session pooler (port 5432); the worker holds a
# long-lived pool, so do NOT use the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# How often (ms) the worker polls simulation_jobs for queued work.
WORKER_POLL_INTERVAL_MS=2000

# debug | info | warn | error
LOG_LEVEL=info

# Not used in Phase 1. Required once the Phase 2 pipeline lands.
ANTHROPIC_API_KEY=
